# =====================================================================
# CareerMesh Configuration Template
# Copy this file to .env and configure your optional settings.
# Default demo mode works 100% out-of-the-box with NO API keys!
# =====================================================================

# Optional LLM Provider ("gemini", "openai", or leave blank for rule-based)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Online Resource URL Verification (true / false)
ENABLE_ONLINE_VERIFICATION=false

# Skill Weighting Configuration (Sum = 1.0)
REQUIRED_SKILLS_WEIGHT=0.70
PREFERRED_SKILLS_WEIGHT=0.30
